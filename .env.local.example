# Social sign-in. Both providers use a full-page redirect to
# /auth/{provider}/callback. Each redirect URI must match the API's matching
# *_REDIRECT_URI exactly and be registered on the provider's app:
#   Google   -> Cloud Console, "Authorized redirect URIs"
#   LinkedIn -> app settings, "Authorized redirect URLs"
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

NEXT_PUBLIC_LINKEDIN_CLIENT_ID=your-linkedin-client-id
NEXT_PUBLIC_LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback
