# Google OAuth (client-side — used by @react-oauth/google)
# The popup code flow exchanges against "postmessage", so no redirect URI here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# LinkedIn OAuth (client-side — used for the popup flow)
NEXT_PUBLIC_LINKEDIN_CLIENT_ID=your-linkedin-client-id

# Must exactly match the API's LINKEDIN_REDIRECT_URI, and be registered on the
# LinkedIn app. The backend sends the same value when it redeems the code.
NEXT_PUBLIC_LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback
